<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidDiffRapidPackage">
    <Groups>
      <!-- Solution Explorer: single item and multi-selection context menus. -->
      <Group guid="guidDiffRapidCommandSet" id="SolutionExplorerGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_ITEMNODE" />
      </Group>
      <Group guid="guidDiffRapidCommandSet" id="MultiItemGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_XPROJ_MULTIITEM" />
      </Group>
      <Group guid="guidDiffRapidCommandSet" id="ToolsMenuGroup" priority="0x0100">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
      <!-- Code editor context menu: compare the selection or the document. -->
      <Group guid="guidDiffRapidCommandSet" id="EditorContextGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidDiffRapidCommandSet" id="cmdidCompareSelected" priority="0x0100" type="Button">
        <Parent guid="guidDiffRapidCommandSet" id="SolutionExplorerGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Compare Selected with DiffRapid</ButtonText>
          <CanonicalName>.DiffRapid.CompareSelected</CanonicalName>
          <LocCanonicalName>.DiffRapid.CompareSelected</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidDiffRapidCommandSet" id="cmdidCompareFolders" priority="0x0101" type="Button">
        <Parent guid="guidDiffRapidCommandSet" id="ToolsMenuGroup" />
        <Strings>
          <ButtonText>DiffRapid: Compare Folders...</ButtonText>
          <CanonicalName>.DiffRapid.CompareFolders</CanonicalName>
          <LocCanonicalName>.DiffRapid.CompareFolders</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidDiffRapidCommandSet" id="cmdidCompareFiles" priority="0x0100" type="Button">
        <Parent guid="guidDiffRapidCommandSet" id="ToolsMenuGroup" />
        <Strings>
          <ButtonText>DiffRapid: Compare Files...</ButtonText>
          <CanonicalName>.DiffRapid.CompareFiles</CanonicalName>
          <LocCanonicalName>.DiffRapid.CompareFiles</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidDiffRapidCommandSet" id="cmdidMergeFiles" priority="0x0102" type="Button">
        <Parent guid="guidDiffRapidCommandSet" id="ToolsMenuGroup" />
        <Strings>
          <ButtonText>DiffRapid: Merge Files...</ButtonText>
          <CanonicalName>.DiffRapid.MergeFiles</CanonicalName>
          <LocCanonicalName>.DiffRapid.MergeFiles</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidDiffRapidCommandSet" id="cmdidCompareWithClipboard" priority="0x0100" type="Button">
        <Parent guid="guidDiffRapidCommandSet" id="EditorContextGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Compare with Clipboard (DiffRapid)</ButtonText>
          <CanonicalName>.DiffRapid.CompareWithClipboard</CanonicalName>
          <LocCanonicalName>.DiffRapid.CompareWithClipboard</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidDiffRapidCommandSet" id="cmdidSelectForCompare" priority="0x0101" type="Button">
        <Parent guid="guidDiffRapidCommandSet" id="EditorContextGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Select for Compare (DiffRapid)</ButtonText>
          <CanonicalName>.DiffRapid.SelectForCompare</CanonicalName>
          <LocCanonicalName>.DiffRapid.SelectForCompare</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidDiffRapidCommandSet" id="cmdidCompareWithSelected" priority="0x0102" type="Button">
        <Parent guid="guidDiffRapidCommandSet" id="EditorContextGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Compare with Selected (DiffRapid)</ButtonText>
          <CanonicalName>.DiffRapid.CompareWithSelected</CanonicalName>
          <LocCanonicalName>.DiffRapid.CompareWithSelected</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidDiffRapidCommandSet" id="cmdidCompareWithVersion" priority="0x0101" type="Button">
        <Parent guid="guidDiffRapidCommandSet" id="SolutionExplorerGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Compare with Earlier Version (DiffRapid)...</ButtonText>
          <CanonicalName>.DiffRapid.CompareWithVersion</CanonicalName>
          <LocCanonicalName>.DiffRapid.CompareWithVersion</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidDiffRapidCommandSet" id="cmdidCompareDocumentWithVersion" priority="0x0103" type="Button">
        <Parent guid="guidDiffRapidCommandSet" id="EditorContextGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Compare with Earlier Version (DiffRapid)...</ButtonText>
          <CanonicalName>.DiffRapid.CompareDocumentWithVersion</CanonicalName>
          <LocCanonicalName>.DiffRapid.CompareDocumentWithVersion</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidDiffRapidCommandSet" id="cmdidCompareWithSaved" priority="0x0104" type="Button">
        <Parent guid="guidDiffRapidCommandSet" id="EditorContextGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Compare with Saved File (DiffRapid)</ButtonText>
          <CanonicalName>.DiffRapid.CompareWithSaved</CanonicalName>
          <LocCanonicalName>.DiffRapid.CompareWithSaved</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidDiffRapidCommandSet" id="cmdidCompareDocumentWithHistory" priority="0x0105" type="Button">
        <Parent guid="guidDiffRapidCommandSet" id="EditorContextGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Compare with Local History (DiffRapid)...</ButtonText>
          <CanonicalName>.DiffRapid.CompareDocumentWithHistory</CanonicalName>
          <LocCanonicalName>.DiffRapid.CompareDocumentWithHistory</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidDiffRapidCommandSet" id="cmdidCompareWithHistory" priority="0x0103" type="Button">
        <Parent guid="guidDiffRapidCommandSet" id="SolutionExplorerGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Compare with Local History (DiffRapid)...</ButtonText>
          <CanonicalName>.DiffRapid.CompareWithHistory</CanonicalName>
          <LocCanonicalName>.DiffRapid.CompareWithHistory</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidDiffRapidCommandSet" id="cmdidApplyPatch" priority="0x0103" type="Button">
        <Parent guid="guidDiffRapidCommandSet" id="ToolsMenuGroup" />
        <Strings>
          <ButtonText>DiffRapid: Apply Patch...</ButtonText>
          <CanonicalName>.DiffRapid.ApplyPatch</CanonicalName>
          <LocCanonicalName>.DiffRapid.ApplyPatch</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidDiffRapidCommandSet" id="cmdidApplySelectedPatch" priority="0x0102" type="Button">
        <Parent guid="guidDiffRapidCommandSet" id="SolutionExplorerGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Apply Patch (DiffRapid)...</ButtonText>
          <CanonicalName>.DiffRapid.ApplySelectedPatch</CanonicalName>
          <LocCanonicalName>.DiffRapid.ApplySelectedPatch</LocCanonicalName>
        </Strings>
      </Button>

      <!-- File comparison window commands: only on keys (see KeyBindings) and in Tools > Options > Keyboard. -->
      <Button guid="guidDiffRapidCommandSet" id="cmdidPreviousDifference" priority="0x0200" type="Button">
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>DiffRapid: Previous Difference</ButtonText>
          <CanonicalName>.DiffRapid.PreviousDifference</CanonicalName>
          <LocCanonicalName>.DiffRapid.PreviousDifference</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidDiffRapidCommandSet" id="cmdidNextDifference" priority="0x0201" type="Button">
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>DiffRapid: Next Difference</ButtonText>
          <CanonicalName>.DiffRapid.NextDifference</CanonicalName>
          <LocCanonicalName>.DiffRapid.NextDifference</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidDiffRapidCommandSet" id="cmdidCopyToLeft" priority="0x0202" type="Button">
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>DiffRapid: Copy Difference to Left</ButtonText>
          <CanonicalName>.DiffRapid.CopyToLeft</CanonicalName>
          <LocCanonicalName>.DiffRapid.CopyToLeft</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidDiffRapidCommandSet" id="cmdidCopyToRight" priority="0x0203" type="Button">
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>DiffRapid: Copy Difference to Right</ButtonText>
          <CanonicalName>.DiffRapid.CopyToRight</CanonicalName>
          <LocCanonicalName>.DiffRapid.CopyToRight</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <!--
    Scoped to the file comparison window (its command UI is guidDiffWindow, inheriting the text editor's
    bindings), so these win over the editor's Alt+arrow bindings there and nowhere else.
  -->
  <KeyBindings>
    <KeyBinding guid="guidDiffRapidCommandSet" id="cmdidPreviousDifference" editor="guidDiffWindow" key1="VK_UP" mod1="Alt" />
    <KeyBinding guid="guidDiffRapidCommandSet" id="cmdidNextDifference" editor="guidDiffWindow" key1="VK_DOWN" mod1="Alt" />
    <!--
      F8 keys work where Alt+arrows are taken by the OS (e.g. Mac keyboards send Alt as the Windows key).
      F8 / Shift+F8 match Visual Studio's own diff.
    -->
    <KeyBinding guid="guidDiffRapidCommandSet" id="cmdidPreviousDifference" editor="guidDiffWindow" key1="VK_F8" mod1="Shift" />
    <KeyBinding guid="guidDiffRapidCommandSet" id="cmdidNextDifference" editor="guidDiffWindow" key1="VK_F8" />
    <KeyBinding guid="guidDiffRapidCommandSet" id="cmdidCopyToLeft" editor="guidDiffWindow" key1="VK_F8" mod1="Control Shift" />
    <KeyBinding guid="guidDiffRapidCommandSet" id="cmdidCopyToRight" editor="guidDiffWindow" key1="VK_F8" mod1="Control" />
    <KeyBinding guid="guidDiffRapidCommandSet" id="cmdidCopyToLeft" editor="guidDiffWindow" key1="VK_LEFT" mod1="Alt" />
    <KeyBinding guid="guidDiffRapidCommandSet" id="cmdidCopyToRight" editor="guidDiffWindow" key1="VK_RIGHT" mod1="Alt" />
  </KeyBindings>

  <CommandPlacements>
    <CommandPlacement guid="guidDiffRapidCommandSet" id="cmdidCompareSelected" priority="0x0100">
      <Parent guid="guidDiffRapidCommandSet" id="MultiItemGroup" />
    </CommandPlacement>
  </CommandPlacements>

  <VisibilityConstraints>
    <!-- Load the package for the selection check whenever a solution or folder is open. -->
    <VisibilityItem guid="guidDiffRapidCommandSet" id="cmdidCompareSelected" context="UICONTEXT_SolutionExists" />
  </VisibilityConstraints>

  <Symbols>
    <GuidSymbol name="guidDiffRapidPackage" value="{d62115b4-a651-44ed-87ba-2400bf8f2a7e}" />
    <GuidSymbol name="guidDiffRapidCommandSet" value="{cd4a73c1-601e-4ff6-83c2-8fef6a7455e5}">
      <IDSymbol name="SolutionExplorerGroup" value="0x1020" />
      <IDSymbol name="MultiItemGroup" value="0x1021" />
      <IDSymbol name="ToolsMenuGroup" value="0x1022" />
      <IDSymbol name="EditorContextGroup" value="0x1023" />
      <IDSymbol name="cmdidCompareSelected" value="0x0100" />
      <IDSymbol name="cmdidCompareFiles" value="0x0101" />
      <IDSymbol name="cmdidCompareFolders" value="0x0102" />
      <IDSymbol name="cmdidMergeFiles" value="0x0103" />
      <IDSymbol name="cmdidCompareWithClipboard" value="0x0104" />
      <IDSymbol name="cmdidSelectForCompare" value="0x0105" />
      <IDSymbol name="cmdidCompareWithSelected" value="0x0106" />
      <IDSymbol name="cmdidCompareWithVersion" value="0x0107" />
      <IDSymbol name="cmdidCompareDocumentWithVersion" value="0x0108" />
      <IDSymbol name="cmdidApplyPatch" value="0x0109" />
      <IDSymbol name="cmdidApplySelectedPatch" value="0x010A" />
      <IDSymbol name="cmdidCompareWithSaved" value="0x010B" />
      <IDSymbol name="cmdidCompareWithHistory" value="0x010C" />
      <IDSymbol name="cmdidCompareDocumentWithHistory" value="0x010D" />
      <IDSymbol name="cmdidPreviousDifference" value="0x0200" />
      <IDSymbol name="cmdidNextDifference" value="0x0201" />
      <IDSymbol name="cmdidCopyToLeft" value="0x0202" />
      <IDSymbol name="cmdidCopyToRight" value="0x0203" />
    </GuidSymbol>
    <!-- The comparison document window; also its key binding scope. -->
    <GuidSymbol name="guidDiffWindow" value="{26ef4ac2-8d5b-4904-a008-96ca9cd7af9b}" />
  </Symbols>
</CommandTable>
