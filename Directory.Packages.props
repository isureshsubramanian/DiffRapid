<Project>
  <ItemGroup>
    <!-- Visual Studio extension (compiled against 17.14 so VS 2022 support stays a manifest change) -->
    <PackageVersion Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" />
    <PackageVersion Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15" />
    <!-- Core: reads .NET assembly metadata for the API compare (MIT) -->
    <PackageVersion Include="System.Reflection.Metadata" Version="9.0.0" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
  </ItemGroup>
</Project>
